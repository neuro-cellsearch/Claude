{
  "name": "kairo-systems-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "env:local": "node scripts/gen-local-env.mjs",
    "admin:grant": "node --env-file-if-exists=.env.local scripts/grant-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "openai": "^7.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
