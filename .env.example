# =============================================================================
# Kairo Systems — environment configuration
# Copy to .env.local (development) or set in your hosting provider (production).
# NEVER commit real values. Variables prefixed NEXT_PUBLIC_ are exposed to the
# browser — only public, non-secret values may use that prefix.
# Every integration is optional except Supabase: unconfigured integrations are
# shown as "Not configured" in Admin → Integrations, never as working.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public business details shown in the footer, legal pages and outreach emails
NEXT_PUBLIC_COMPANY_LEGAL_NAME="Kairo Systems Ltd"
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_ICO_REGISTRATION=

# --- Supabase (REQUIRED) — Project Settings → API ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by `npm run db:migrate` and scripts.
DATABASE_URL=

# --- Security (REQUIRED) ----------------------------------------------------
# 32 random bytes, base64. Encrypts customer integration credentials (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Shared secret used to HMAC-sign webhooks from n8n/Make into /api/automations/events
AUTOMATION_WEBHOOK_SECRET=
# Bearer token required by /api/cron/* (set the same value in your scheduler)
CRON_SECRET=
# Salt for hashing IP addresses in logs (we never store raw IPs)
IP_HASH_SALT=

# --- Stripe (payments & subscriptions) --------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- OpenAI (website assistant, proposal drafting) --------------------------
OPENAI_API_KEY=
# Any chat-completions model available on your account
OPENAI_MODEL=gpt-5-mini

# --- Email (Resend) — transactional mail, notifications, sequences ----------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Kairo Systems <hello@yourdomain.co.uk>"
EMAIL_FROM=
# Where new-enquiry notifications are sent
ADMIN_NOTIFICATION_EMAIL=

# --- n8n (workflow automation engine) ---------------------------------------
# Base URL of your n8n instance, e.g. https://n8n.yourdomain.co.uk
N8N_BASE_URL=
# n8n → Settings → API → create API key
N8N_API_KEY=

# --- Make (optional alternative to n8n) -------------------------------------
MAKE_API_TOKEN=
# Zone, e.g. eu1.make.com or eu2.make.com
MAKE_ZONE=eu1.make.com

# --- Twilio (SMS / voice for AI receptionist) -------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- ElevenLabs (voice synthesis, optional) ---------------------------------
ELEVENLABS_API_KEY=

# --- HubSpot (CRM integration via private app token) ------------------------
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Calendly (optional: embed instead of the built-in booking calendar) ----
CALENDLY_API_TOKEN=
NEXT_PUBLIC_CALENDLY_URL=

# --- Google Calendar (optional, service account JSON, base64-encoded) -------
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_CALENDAR_ID=

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
